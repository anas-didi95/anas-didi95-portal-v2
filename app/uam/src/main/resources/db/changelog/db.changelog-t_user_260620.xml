			<column name="UPDATE_BY" type="VARCHAR(20)">
				<constraints nullable="false" />
			</column>
			<column name="UPDATE_DT" type="TIMESTAMP WITH TIME ZONE">
				<constraints nullable="false" />
			</column>
			<!-- Metadata END -->
			<column name="USERNAME" type="VARCHAR(20)">
				<constraints nullable="false" />
			</column>
			<column name="PWD" type="VARCHAR(100)">
