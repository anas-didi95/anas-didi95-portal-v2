<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<!-- Include Spring Boot defaults so converters like %clr and %wEx are registered -->
	<include
		resource="org/springframework/boot/logging/logback/defaults.xml" />

	<!-- Spring Boot default log pattern variables -->
	<property name="LOG_PATH" value="${LOG_PATH:-./logs}" />

	<!-- Console Appender (default Boot pattern) -->
	<appender name="CONSOLE"
		class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>${CONSOLE_LOG_PATTERN}</pattern>
		</encoder>
	</appender>

	<!-- File Appender with daily + size-based rolling policy -->
	<appender name="FILE"
		class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_PATH}/uam.log</file>
		<encoder>
			<pattern>${FILE_LOG_PATTERN}</pattern>
		</encoder>
		<rollingPolicy
			class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>${LOG_PATH}/archived/uam-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
			<maxFileSize>100MB</maxFileSize>
			<maxHistory>30</maxHistory>
			<totalSizeCap>10GB</totalSizeCap>
		</rollingPolicy>
	</appender>

	<!-- Root logger at INFO level -->
	<root level="INFO">
		<appender-ref ref="CONSOLE" />
		<appender-ref ref="FILE" />
	</root>
</configuration>
